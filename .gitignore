# Local overrides (e.g. .zshrc.local, .gitconfig.local)
*.local
!home/.local/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Runtime output that hooks/tools may write next to their source
*.log
*.tmp.*
strix_runs

# Belt-and-braces secret patterns (apply everywhere)
**/.credentials*
**/credentials.json
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/*.token
**/*_token
*.pem
*.key
id_rsa*
id_ed25519*

# ~/.claude is a real runtime dir on every machine; only these entries are linked into
# the repo. Anything else that appears under home/.claude is a mistake — see `apply`.
home/.claude/*
!home/.claude/CLAUDE.md
!home/.claude/settings.json
!home/.claude/commands/
!home/.claude/hooks/

# ~/.agents is linked wholesale (skills CLI writes here). Its lock file IS tracked.
home/.agents/skills/*/node_modules/

# home/.config — only what we deliberately track
home/.config/*
!home/.config/opencode/
home/.config/opencode/*
!home/.config/opencode/opencode.json
!home/.config/mise/
!home/.config/mise/config.toml

# home/.ssh — only the config file, never keys or known_hosts
home/.ssh/*
!home/.ssh/config

# home/.local — only ~/.local/bin is intentional
home/.local/*
!home/.local/bin/
!home/.local/bin/**
