#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="$HOME/.config/vps-setup/state.json"
STEPS_DIR="$SCRIPT_DIR/steps"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Ensure gum is installed
ensure_gum() {
    if ! command -v gum &> /dev/null; then
        echo -e "${CYAN}Installing gum...${NC}"
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
        echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
        sudo apt update && sudo apt install -y gum
    fi
}

# Initialize state file
init_state() {
    mkdir -p "$(dirname "$STATE_FILE")"
    if [[ ! -f "$STATE_FILE" ]]; then
        cat > "$STATE_FILE" << 'EOF'
{
  "tailscale": false,
  "ufw": false,
  "disable_ssh": false,
  "base_packages": false,
  "docker": false,
  "node": false,
  "bun": false,
  "claude": false,
  "tmux": false,
  "zsh": false,
  "dotfiles": false,
  "syncthing": false,
  "aws_sso": false
}
EOF
    fi
}

# Read state
get_state() {
    local key=$1
    if command -v jq &> /dev/null; then
        jq -r ".$key" "$STATE_FILE"
    else
        grep "\"$key\"" "$STATE_FILE" | grep -q "true" && echo "true" || echo "false"
    fi
}

# Update state
set_state() {
    local key=$1
    local value=$2
    if command -v jq &> /dev/null; then
        local tmp=$(mktemp)
        jq ".$key = $value" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
    else
        sed -i "s/\"$key\": [a-z]*/\"$key\": $value/" "$STATE_FILE"
    fi
}

# Get status icon
status_icon() {
    local key=$1
    if [[ "$(get_state "$key")" == "true" ]]; then
        echo "✓"
    else
        echo "○"
    fi
}

# Build menu items with status
build_menu() {
    echo "$(status_icon tailscale) Tailscale SSH - Secure mesh VPN access"
    echo "$(status_icon ufw) UFW Firewall - Lock down to Tailscale only"
    echo "$(status_icon disable_ssh) Disable OpenSSH - Remove traditional SSH"
    echo "$(status_icon base_packages) Base Packages - eza, bat, lazygit, gh, etc."
    echo "$(status_icon docker) Docker - Container runtime"
    echo "$(status_icon node) Node.js - via fnm (version manager)"
    echo "$(status_icon bun) Bun - Fast JS runtime"
    echo "$(status_icon claude) Claude Code - AI coding assistant"
    echo "$(status_icon tmux) tmux - Terminal multiplexer"
    echo "$(status_icon zsh) zsh - Shell configuration"
    echo "$(status_icon dotfiles) Dotfiles - tmux, zsh, git, GPG signing"
    echo "$(status_icon syncthing) Syncthing - File sync to laptop"
    echo "$(status_icon aws_sso) AWS SSO - IAM Identity Center setup"
}

# Run a step
run_step() {
    local step=$1
    local script="$STEPS_DIR/$step.sh"

    if [[ -f "$script" ]]; then
        echo ""
        gum style --border normal --padding "1 2" --border-foreground 212 "Running: $step"
        echo ""

        if bash "$script"; then
            set_state "$step" true
            gum style --foreground 212 "✓ $step completed"
            return 0
        else
            gum style --foreground 196 "✗ $step failed"
            return 1
        fi
    else
        echo "Script not found: $script"
        return 1
    fi
}

# Main menu
main_menu() {
    while true; do
        clear
        gum style \
            --border double \
            --align center \
            --width 60 \
            --margin "1 2" \
            --padding "1 2" \
            --border-foreground 212 \
            "🖥️  VPS Environment Setup" \
            "" \
            "Select steps to run (space to select, enter to confirm)"

        echo ""

        # Show current status
        gum style --faint "Current Status:"
        echo ""
        build_menu | while read line; do
            if [[ "$line" == ✓* ]]; then
                gum style --foreground 212 "  $line"
            else
                echo "  $line"
            fi
        done

        echo ""

        CHOICE=$(gum choose \
            "Run All Remaining" \
            "Select Steps" \
            "Run Security Analysis" \
            "Reset State" \
            "Exit" \
        )

        case "$CHOICE" in
            "Run All Remaining")
                run_all_remaining
                gum input --placeholder "Press enter to continue..."
                ;;
            "Select Steps")
                select_steps
                ;;
            "Run Security Analysis")
                bash "$SCRIPT_DIR/scripts/analyze.sh"
                gum input --placeholder "Press enter to continue..."
                ;;
            "Reset State")
                if gum confirm "Reset all progress?"; then
                    rm -f "$STATE_FILE"
                    init_state
                    gum style --foreground 212 "State reset!"
                    sleep 1
                fi
                ;;
            "Exit")
                echo ""
                gum style --foreground 212 "Happy coding! 🚀"
                exit 0
                ;;
        esac
    done
}

# Run all remaining steps
run_all_remaining() {
    local steps=(
        "tailscale"
        "ufw"
        "disable_ssh"
        "base_packages"
        "docker"
        "node"
        "bun"
        "claude"
        "tmux"
        "zsh"
        "dotfiles"
        "syncthing"
        "aws_sso"
    )

    for step in "${steps[@]}"; do
        if [[ "$(get_state "$step")" != "true" ]]; then
            if ! run_step "$step"; then
                if ! gum confirm "Step failed. Continue with remaining steps?"; then
                    return 1
                fi
            fi
        fi
    done

    echo ""
    gum style \
        --border normal \
        --padding "1 2" \
        --border-foreground 212 \
        "🎉 Setup Complete!" \
        "" \
        "Run './setup' again to check status or run analysis"
}

# Select specific steps
select_steps() {
    local options=(
        "tailscale:Tailscale SSH"
        "ufw:UFW Firewall"
        "disable_ssh:Disable OpenSSH"
        "base_packages:Base Packages"
        "docker:Docker"
        "node:Node.js (fnm)"
        "bun:Bun"
        "claude:Claude Code"
        "tmux:tmux"
        "zsh:zsh config"
        "dotfiles:Dotfiles"
        "syncthing:Syncthing"
        "aws_sso:AWS SSO"
    )

    # Build selection list
    local items=()
    for opt in "${options[@]}"; do
        local key="${opt%%:*}"
        local label="${opt#*:}"
        local status=$(status_icon "$key")
        items+=("$status $label")
    done

    SELECTED=$(printf '%s\n' "${items[@]}" | gum choose --no-limit --header "Select steps to run:")

    if [[ -n "$SELECTED" ]]; then
        echo "$SELECTED" | while read selection; do
            # Extract step name from selection
            for opt in "${options[@]}"; do
                local key="${opt%%:*}"
                local label="${opt#*:}"
                if [[ "$selection" == *"$label"* ]]; then
                    run_step "$key"
                fi
            done
        done
        gum input --placeholder "Press enter to continue..."
    fi
}

# Entry point
main() {
    ensure_gum
    init_state

    # Check for jq, install if missing
    if ! command -v jq &> /dev/null; then
        sudo apt install -y jq
    fi

    main_menu
}

main "$@"
