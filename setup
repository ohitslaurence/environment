#!/bin/bash
set -euo pipefail

# Fix for terminals like Ghostty that the remote system may not recognize
if ! infocmp "$TERM" &>/dev/null 2>&1; then
    export TERM=xterm-256color
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="$HOME/.config/vps-setup/state.json"
STEPS_DIR="$SCRIPT_DIR/steps"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============================================================================
# ROOT GATE - Must create user before proceeding
# ============================================================================
root_gate() {
    if [[ $EUID -ne 0 ]]; then
        return 0  # Not root, proceed
    fi

    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "                    Running as root"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    echo -e "${YELLOW}⚠ You must create a regular user before proceeding.${NC}"
    echo ""
    echo "Running the full setup as root is not allowed because:"
    echo "  • User-specific tools (fnm, bun, claude) install to wrong location"
    echo "  • Tailscale SSH needs a regular user to map your identity"
    echo "  • It's a security best practice"
    echo ""

    # Ensure gum is available for prompts
    if ! command -v gum &> /dev/null; then
        echo "Installing gum for interactive prompts..."
        apt update -qq
        mkdir -p /etc/apt/keyrings
        curl -fsSL https://repo.charm.sh/apt/gpg.key | gpg --dearmor -o /etc/apt/keyrings/charm.gpg 2>/dev/null
        echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | tee /etc/apt/sources.list.d/charm.list > /dev/null
        apt update -qq && apt install -y gum > /dev/null
    fi

    echo ""
    USERNAME=$(gum input --placeholder "Enter username to create" --header "Create a sudo user:")

    if [[ -z "$USERNAME" ]]; then
        echo -e "${RED}No username provided. Exiting.${NC}"
        exit 1
    fi

    if id "$USERNAME" &>/dev/null; then
        echo "User '$USERNAME' already exists."
        if ! groups "$USERNAME" | grep -q sudo; then
            echo "Adding $USERNAME to sudo group..."
            usermod -aG sudo "$USERNAME"
        fi
    else
        echo ""
        echo "Creating user '$USERNAME'..."
        echo "You'll be prompted to set a password (needed for sudo)."
        echo ""
        adduser "$USERNAME"
        usermod -aG sudo "$USERNAME"
    fi

    # Copy environment repo to new user
    echo ""
    echo "Copying environment repo to /home/$USERNAME/dev..."
    mkdir -p "/home/$USERNAME/dev"
    cp -r "$SCRIPT_DIR" "/home/$USERNAME/dev/"
    chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/dev"

    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo -e "                    ${GREEN}User Created!${NC}"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    echo "Now run:"
    echo ""
    echo -e "  ${CYAN}su - $USERNAME${NC}"
    echo -e "  ${CYAN}cd ~/dev/environment${NC}"
    echo -e "  ${CYAN}./setup${NC}"
    echo ""
    exit 0
}

# ============================================================================
# Ensure gum is installed
# ============================================================================
ensure_gum() {
    if ! command -v gum &> /dev/null; then
        echo -e "${CYAN}Installing gum...${NC}"
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
        echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
        sudo apt update && sudo apt install -y gum
    fi
}

# ============================================================================
# State management
# ============================================================================
init_state() {
    mkdir -p "$(dirname "$STATE_FILE")"
    if [[ ! -f "$STATE_FILE" ]]; then
        cat > "$STATE_FILE" << 'EOF'
{
  "tailscale": false,
  "ufw": false,
  "disable_ssh": false,
  "base_packages": false,
  "zsh": false,
  "tmux": false,
  "dotfiles": false,
  "github_ssh": false,
  "docker": false,
  "node": false,
  "bun": false,
  "claude": false,
  "opencode": false,
  "syncthing": false,
  "aws_sso": false
}
EOF
    fi
}

get_state() {
    local key=$1
    jq -r ".$key" "$STATE_FILE"
}

set_state() {
    local key=$1
    local value=$2
    local tmp=$(mktemp)
    jq ".$key = $value" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

status_icon() {
    local key=$1
    if [[ "$(get_state "$key")" == "true" ]]; then
        echo "✓"
    else
        echo "○"
    fi
}

# ============================================================================
# Menu and steps
# ============================================================================
build_menu() {
    echo "$(status_icon tailscale) Tailscale SSH - Secure mesh VPN access"
    echo "$(status_icon ufw) UFW Firewall - Lock down to Tailscale only"
    echo "$(status_icon disable_ssh) Disable OpenSSH - Remove traditional SSH"
    echo "$(status_icon base_packages) Base Packages - eza, bat, lazygit, gh, etc."
    echo "$(status_icon zsh) zsh - Set as default shell"
    echo "$(status_icon tmux) tmux - Terminal multiplexer"
    echo "$(status_icon dotfiles) Dotfiles - shell, tmux, git, GPG signing"
    echo "$(status_icon github_ssh) GitHub SSH - SSH key for git operations"
    echo "$(status_icon docker) Docker - Container runtime"
    echo "$(status_icon node) Node.js - via fnm (version manager)"
    echo "$(status_icon bun) Bun - Fast JS runtime"
    echo "$(status_icon claude) Claude Code - AI coding assistant"
    echo "$(status_icon opencode) OpenCode - AI coding assistant"
    echo "$(status_icon syncthing) Syncthing - File sync to laptop"
    echo "$(status_icon aws_sso) AWS SSO - IAM Identity Center setup"
}

run_step() {
    local step=$1
    local script="$STEPS_DIR/$step.sh"

    if [[ -f "$script" ]]; then
        echo ""
        gum style --border normal --padding "1 2" --border-foreground 212 "Running: $step"
        echo ""

        if bash "$script"; then
            set_state "$step" true
            gum style --foreground 212 "✓ $step completed"
            return 0
        else
            gum style --foreground 196 "✗ $step failed"
            return 1
        fi
    else
        echo "Script not found: $script"
        return 1
    fi
}

main_menu() {
    while true; do
        clear
        gum style \
            --border double \
            --align center \
            --width 60 \
            --margin "1 2" \
            --padding "1 2" \
            --border-foreground 212 \
            "🖥️  VPS Environment Setup" \
            "" \
            "Running as: $USER"

        echo ""
        gum style --faint "Current Status:"
        echo ""
        build_menu | while read line; do
            if [[ "$line" == ✓* ]]; then
                gum style --foreground 212 "  $line"
            else
                echo "  $line"
            fi
        done

        echo ""

        CHOICE=$(gum choose \
            "Run All Remaining" \
            "Select Steps" \
            "Run Security Analysis" \
            "Reset State" \
            "Exit" \
        )

        case "$CHOICE" in
            "Run All Remaining")
                run_all_remaining
                gum input --placeholder "Press enter to continue..."
                ;;
            "Select Steps")
                select_steps
                ;;
            "Run Security Analysis")
                bash "$SCRIPT_DIR/scripts/analyze.sh"
                gum input --placeholder "Press enter to continue..."
                ;;
            "Reset State")
                if gum confirm "Reset all progress?"; then
                    rm -f "$STATE_FILE"
                    init_state
                    gum style --foreground 212 "State reset!"
                    sleep 1
                fi
                ;;
            "Exit")
                echo ""
                gum style --foreground 212 "Happy coding! 🚀"
                exit 0
                ;;
        esac
    done
}

run_all_remaining() {
    local steps=(
        "tailscale"
        "ufw"
        "disable_ssh"
        "base_packages"
        "zsh"
        "tmux"
        "dotfiles"
        "github_ssh"
        "docker"
        "node"
        "bun"
        "claude"
        "opencode"
        "syncthing"
        "aws_sso"
    )

    for step in "${steps[@]}"; do
        if [[ "$(get_state "$step")" != "true" ]]; then
            if ! run_step "$step"; then
                if ! gum confirm "Step failed. Continue with remaining steps?"; then
                    return 1
                fi
            fi
        fi
    done

    echo ""
    gum style \
        --border normal \
        --padding "1 2" \
        --border-foreground 212 \
        "🎉 Setup Complete!" \
        "" \
        "Run './setup' again to check status or run analysis"
}

select_steps() {
    local options=(
        "tailscale:Tailscale SSH"
        "ufw:UFW Firewall"
        "disable_ssh:Disable OpenSSH"
        "base_packages:Base Packages"
        "zsh:zsh"
        "tmux:tmux"
        "dotfiles:Dotfiles"
        "github_ssh:GitHub SSH"
        "docker:Docker"
        "node:Node.js (fnm)"
        "bun:Bun"
        "claude:Claude Code"
        "opencode:OpenCode"
        "syncthing:Syncthing"
        "aws_sso:AWS SSO"
    )

    local items=()
    for opt in "${options[@]}"; do
        local key="${opt%%:*}"
        local label="${opt#*:}"
        local status=$(status_icon "$key")
        items+=("$status $label")
    done

    SELECTED=$(printf '%s\n' "${items[@]}" | gum choose --header "Select a step to run:")

    if [[ -n "$SELECTED" ]]; then
        for opt in "${options[@]}"; do
            local key="${opt%%:*}"
            local label="${opt#*:}"
            if [[ "$SELECTED" == *"$label"* ]]; then
                run_step "$key"
                break
            fi
        done
        gum input --placeholder "Press enter to continue..."
    fi
}

# ============================================================================
# Entry point
# ============================================================================
main() {
    # GATE: Must not be root
    root_gate

    ensure_gum
    init_state

    # Ensure jq is available
    if ! command -v jq &> /dev/null; then
        sudo apt install -y jq
    fi

    main_menu
}

main "$@"
