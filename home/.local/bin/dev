#!/usr/bin/env node

// dev — herdr port of `work`: task-first wrapper around herdr worktrees + gritty.
// Single-repo contexts branch as <repo>__<task> with the checkout at
// <repo-path>-wt-<task>; cross-repo contexts branch as <task> in every repo.
// Shares the `work` repo registry (repos.tsv) so both tools agree on repos.

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const readline = require("node:readline/promises");
const { spawnSync } = require("node:child_process");

const DEV_REPOS_FILE =
  process.env.DEV_REPOS_FILE ||
  process.env.WORK_REPOS_FILE ||
  path.join(os.homedir(), ".config", "work", "repos.tsv");
const DEFAULT_TABS = ["shell", "agent"];
const LABEL_SEP = "__";

async function main() {
  const args = process.argv.slice(2);

  if (args.length === 0) {
    await cmdDashboard();
    return;
  }

  const [command, ...rest] = args;

  switch (command) {
    case "help":
    case "--help":
    case "-h":
      printHelp();
      return;
    case "--knows":
      process.exit(loadRepos()[rest[0]] ? 0 : 1);
      return;
    case "pick":
      await cmdDashboard();
      return;
    case "ls":
      cmdLs();
      return;
    case "repos":
      cmdRepos(rest);
      return;
    case "branch":
      await cmdBranch(rest);
      return;
    case "cross":
      cmdCross(rest);
      return;
    case "done":
      cmdDone(rest);
      return;
    case "refresh":
      cmdRefresh(rest);
      return;
    case "prune":
      cmdPrune(rest);
      return;
    case "save":
      requireInsideGitRepo("dev save");
      requireCommand("gritty");
      runInherit("gritty", ["commit", "--accept"]);
      return;
    case "pr-checkout":
    case "prco":
      cmdPrCheckout(rest);
      return;
    case "pr":
      requireInsideGitRepo("dev pr");
      requireCommand("gritty");
      runInherit("gritty", ["pr", "--accept"]);
      if (hasCommand("gh")) {
        runInherit("gh", ["pr", "checks"]);
      }
      return;
    case "bootstrap":
      cmdBootstrap();
      return;
    case "sync":
      cmdSync();
      return;
    default:
      await cmdRepo(command, rest);
  }
}

function printHelp() {
  console.log(`dev: task-first wrapper around herdr worktrees + gritty

Usage:
  dev pick
  dev <repo> [task]
  dev branch <task>
  dev cross <task> <repo> [repo...]
  dev ls
  dev repos [--json]
  dev sync
  dev refresh [repo]
  dev prune [--dry-run] [--all]
  dev bootstrap
  dev save
  dev pr
  dev pr-checkout <number> [--repo alias]   (alias: prco)
  dev done [label] [--force] [--keep-branch]

Config:
  Repos are discovered by scanning $DEV_REPOS_DIR (default: the parent
  folder of the first repos.tsv entry) for git checkouts; alias = folder
  name. ${DEV_REPOS_FILE} is optional and overrides scanned entries:
  alias<TAB>path<TAB>default_branch

Labels use repo${LABEL_SEP}task format (e.g. rain${LABEL_SEP}fix-auth); cross contexts use the bare task.
Worktrees live beside the repo as <repo>-wt-<task>; PR reviews as <repo>-wt-pr-<n>.
Canonical clones are bare (no working tree): all work happens in worktrees.
'dev done' deletes the branch once it is merged; 'dev prune' reconciles
worktrees, branches, and herdr workspaces (fast path runs on every dashboard,
'--all' also asks GitHub which PRs merged).

(The dev shell function falls back to 'cd $DEV_HOME/<arg>' for anything
that is not a subcommand or configured repo alias.)
`);
}

async function cmdDashboard() {
  requireCommand("herdr");

  const repos = loadRepos();
  quietPrune(repos);
  const contexts = listContexts();

  if (contexts.length === 0) {
    console.log("No active contexts.");
    await openRepoFromDashboard(repos);
    return;
  }

  if (hasCommand("fzf")) {
    const options = [
      ...contexts.map((ctx) => `context\t${contextLabel(ctx, repos)}`),
      ...Object.keys(repos)
        .sort()
        .map((alias) => `repo\t${alias}`),
    ];
    const picked = runFzf(options, "dev> ");
    if (!picked) {
      return;
    }

    const [kind, value] = picked.split("\t");
    if (kind === "context") {
      focusContextByLabel(value, repos);
      return;
    }

    if (kind === "repo") {
      await cmdRepo(value, []);
      return;
    }
  }

  cmdLs();
  console.log("\nRun `dev <repo>` to open or create a task.");
}

async function openRepoFromDashboard(repos) {
  const aliases = Object.keys(repos).sort();
  if (aliases.length === 0) {
    fail(`No repos configured. Create ${DEV_REPOS_FILE} first.`, 1);
  }

  if (hasCommand("fzf")) {
    const picked = runFzf(aliases, "repo> ");
    if (!picked) {
      return;
    }
    await cmdRepo(picked, []);
    return;
  }

  console.log("Configured repos:");
  for (const alias of aliases) {
    console.log(`  ${alias}`);
  }
  console.log("\nRun `dev <repo>` to start.");
}

async function cmdRepo(alias, rest) {
  requireCommand("herdr");

  const repos = loadRepos();
  const repo = repos[alias];
  if (!repo) {
    fail(`Unknown repo '${alias}'. Add it to ${DEV_REPOS_FILE}.`);
  }

  const taskArg = rest[0];
  if (taskArg) {
    createOrOpenSingleRepoContext(alias, normalizeTask(taskArg), repo);
    return;
  }

  const active = listContexts().filter(
    (ctx) => samePath(ctx.worktree.repo_root, repo.path),
  );

  if (active.length === 1) {
    focusWorkspace(active[0].workspace_id);
    return;
  }

  if (active.length > 1 && hasCommand("fzf")) {
    const byLabel = new Map(
      active.map((ctx) => [contextLabel(ctx, repos), ctx]),
    );
    const picked = runFzf([...byLabel.keys(), "[new task]"], `${alias}> `);
    if (!picked) {
      return;
    }
    if (picked !== "[new task]") {
      focusWorkspace(byLabel.get(picked).workspace_id);
      return;
    }
  } else if (active.length > 1) {
    console.log(`Active ${alias} contexts:`);
    for (const ctx of active) {
      console.log(`  ${contextLabel(ctx, repos)}`);
    }
  }

  const task = await promptText(`Task for ${alias}: `);
  createOrOpenSingleRepoContext(alias, normalizeTask(task), repo);
}

async function cmdBranch(rest) {
  if (rest.length === 0) {
    fail("Usage: dev branch <task>");
  }

  const alias = inferCurrentRepoAlias();
  const repos = loadRepos();
  const repo = repos[alias];
  createOrOpenSingleRepoContext(alias, normalizeTask(rest[0]), repo);
}

function cmdCross(rest) {
  requireCommand("herdr");

  if (rest.length < 2) {
    fail("Usage: dev cross <task> <repo> [repo...]");
  }

  const task = normalizeTask(rest[0]);
  const repoAliases = [...new Set(rest.slice(1))];
  const repos = loadRepos();
  const selectedRepos = repoAliases.map((alias) => {
    const repo = repos[alias];
    if (!repo) {
      fail(`Unknown repo '${alias}'. Add it to ${DEV_REPOS_FILE}.`);
    }
    return { alias, ...repo };
  });

  const existing = listContexts().find((ctx) => ctx.label === task);
  if (existing) {
    focusWorkspace(existing.workspace_id);
    return;
  }

  for (const repo of selectedRepos) {
    fetchBase(repo.alias, repo);
  }

  const [primary, ...others] = selectedRepos;
  const worktreePathFor = (repo) => `${repo.path}-wt-${task}`;

  const created = herdrJson([
    "worktree",
    "create",
    "--cwd",
    primary.path,
    "--branch",
    task,
    "--base",
    baseRef(primary),
    "--path",
    worktreePathFor(primary),
    "--label",
    task,
    "--no-focus",
    "--json",
  ]);
  const workspaceId = created.result.workspace.workspace_id;

  for (const repo of others) {
    addGitWorktree(repo, task, worktreePathFor(repo));
  }

  for (const repo of selectedRepos) {
    bootstrapWorktree(worktreePathFor(repo));
  }

  ensureTabs(
    workspaceId,
    worktreePathFor(primary),
    others.map((repo) => ({ name: repo.alias, cwd: worktreePathFor(repo) })),
    task,
  );
  focusWorkspace(workspaceId);
}

// Review a PR in its own worktree instead of `gh pr checkout` (which would
// switch whatever checkout the caller happens to be in, usually canonical).
function cmdPrCheckout(rest) {
  requireCommand("herdr");
  requireCommand("gh");
  requireCommand("git");

  const number = rest.find((arg) => /^\d+$/.test(arg));
  if (!number) {
    fail("Usage: dev pr-checkout <number> [--repo alias]");
  }
  const repos = loadRepos();
  const repoFlag = rest.indexOf("--repo");
  const alias = repoFlag >= 0 ? rest[repoFlag + 1] : inferCurrentRepoAlias();
  const repo = repos[alias];
  if (!repo) {
    fail(`Unknown repo '${alias}'.`);
  }

  const view = runCapture(
    "gh",
    ["pr", "view", number, "--json", "headRefName,headRepositoryOwner,isCrossRepository"],
    { cwd: repo.path },
  );
  const pr = JSON.parse(view.stdout);
  if (pr.isCrossRepository) {
    fail(`PR #${number} comes from a fork; review it manually.`);
  }
  const branch = pr.headRefName;
  const worktreePath = `${repo.path}-wt-pr-${number}`;
  const label = `pr-${number}`;

  const existing = listContexts().find((ctx) =>
    samePath(ctx.worktree.checkout_path, worktreePath),
  );
  if (existing) {
    focusWorkspace(existing.workspace_id);
    return;
  }

  // The PR branch may already be checked out as the author's own context.
  const checkedOutAt = worktreeForBranch(repo, branch);
  if (checkedOutAt) {
    const ctx = listContexts().find((c) => samePath(c.worktree.checkout_path, checkedOutAt));
    if (ctx) {
      console.log(`dev: PR #${number} branch ${branch} is already open as ${ctx.label}`);
      focusWorkspace(ctx.workspace_id);
      return;
    }
    fail(`Branch ${branch} is checked out at ${checkedOutAt}; open that instead.`);
  }

  runInherit("git", ["-C", repo.path, "fetch", "origin", branch]);
  if (localBranchExists(repo.path, branch)) {
    runInherit("git", ["-C", repo.path, "worktree", "add", worktreePath, branch]);
  } else {
    runInherit("git", [
      "-C", repo.path, "worktree", "add", "--track", "-b", branch, worktreePath, `origin/${branch}`,
    ]);
  }
  const opened = herdrJson([
    "worktree", "open", "--cwd", repo.path, "--path", worktreePath, "--label", label, "--no-focus", "--json",
  ]);
  const workspaceId = opened.result.workspace.workspace_id;
  bootstrapWorktree(worktreePath);
  ensureTabs(workspaceId, worktreePath, [], `${alias}${LABEL_SEP}${label}`);
  focusWorkspace(workspaceId);
  console.log(worktreePath);
}

function worktreeForBranch(repo, branch) {
  const listing = runCapture("git", ["-C", repo.path, "worktree", "list", "--porcelain"], { check: false }).stdout;
  for (const block of listing.split("\n\n")) {
    if (block.includes(`\nbranch refs/heads/${branch}\n`) || block.endsWith(`\nbranch refs/heads/${branch}`)) {
      const m = block.match(/^worktree (.+)$/m);
      if (m) {
        return m[1];
      }
    }
  }
  return "";
}

function addGitWorktree(repo, branch, worktreePath) {
  requireCommand("git");
  if (localBranchExists(repo.path, branch)) {
    runInherit("git", ["-C", repo.path, "worktree", "add", worktreePath, branch]);
  } else {
    runInherit("git", [
      "-C",
      repo.path,
      "worktree",
      "add",
      "-b",
      branch,
      worktreePath,
      baseRef(repo),
    ]);
  }
}

function cmdDone(rest) {
  requireCommand("herdr");

  const force = rest.includes("--force") || rest.includes("-f");
  const keepBranch = rest.includes("--keep-branch");
  const labelArg = rest.find((arg) => !arg.startsWith("-"));
  const repos = loadRepos();

  const ctx = labelArg
    ? findContextByLabel(labelArg, repos)
    : currentContext();
  if (!ctx) {
    fail("No current context found. Pass a label: dev done <label>");
  }

  const task = ctx.label;
  const primaryPath = ctx.worktree.checkout_path;
  const branch = currentBranchName(primaryPath);
  const isCross = !branch.includes(LABEL_SEP);

  // Cross contexts have sibling checkouts in every registered repo on the
  // same bare-task branch; single-repo branches are <repo>__<task> so they
  // can never collide with another context's checkouts.
  const siblings = isCross
    ? Object.values(repos)
        .map((repo) => `${repo.path}-wt-${task}`)
        .filter(
          (candidate) =>
            !samePath(candidate, primaryPath) &&
            fs.existsSync(candidate) &&
            currentBranchName(candidate) === branch,
        )
    : [];

  if (!force) {
    for (const checkout of [primaryPath, ...siblings]) {
      if (runCapture("git", ["-C", checkout, "status", "--porcelain"], { check: false }).stdout.trim()) {
        fail(
          `Uncommitted changes in ${checkout} — commit/push them, or 'dev done --force' to discard.`,
        );
      }
    }
  }

  for (const checkout of siblings) {
    const repoRoot = checkout.replace(/-wt-[^/]+$/, "");
    console.log(`dev: removing ${checkout} (branch ${branch} kept)`);
    runInherit("git", [
      "-C",
      repoRoot,
      "worktree",
      "remove",
      ...(force ? ["--force"] : []),
      checkout,
    ]);
  }

  // Focus the parent repo workspace first: removing the workspace kills the
  // pane this command runs in, so it must be the last thing we do.
  const insideTarget = process.env.HERDR_WORKSPACE_ID === ctx.workspace_id;
  if (insideTarget) {
    const info = herdrJson(["worktree", "list", "--workspace", ctx.workspace_id, "--json"]);
    const parent = info.result?.source?.source_workspace_id;
    if (parent) {
      runQuiet("herdr", ["workspace", "focus", parent]);
    }
  }

  const repoRoot = ctx.worktree.repo_root;
  const repo = repos[aliasForRepoRoot(repoRoot, repos)] || { path: repoRoot, base: "main" };
  const merged = !keepBranch && branchIsMerged(repo, branch, { askGitHub: true });
  console.log(
    `dev: removing ${primaryPath} (branch ${branch} ${merged ? "merged, deleting" : "kept"})`,
  );
  runCapture("herdr", [
    "worktree",
    "remove",
    "--workspace",
    ctx.workspace_id,
    ...(force ? ["--force"] : []),
  ]);
  if (merged) {
    runQuiet("git", ["-C", repo.path, "branch", "-D", branch]);
  }
}

// A branch is finished when origin/<base> already contains it (merge or
// rebase) or, with askGitHub, when its PR is merged or closed (squash merges
// leave no ancestry, so git alone cannot tell).
function branchIsMerged(repo, branch, { askGitHub = false, prIndex } = {}) {
  if (!branch || branch === repo.base) {
    return false;
  }
  const ancestor = runCapture(
    "git",
    ["-C", repo.path, "merge-base", "--is-ancestor", branch, baseRef(repo)],
    { check: false },
  );
  if (ancestor.status === 0) {
    return true;
  }
  if (!askGitHub || !hasCommand("gh")) {
    return false;
  }
  const index = prIndex || loadPrIndex(repo);
  const state = index.get(branch);
  return state === "MERGED" || state === "CLOSED";
}

// One GitHub call per repo: head branch -> PR state for recent PRs.
function loadPrIndex(repo) {
  const index = new Map();
  const result = runCapture(
    "gh",
    ["pr", "list", "--state", "all", "--limit", "300", "--json", "headRefName,state"],
    { check: false, cwd: repo.path },
  );
  if (result.status !== 0) {
    return index;
  }
  try {
    for (const pr of JSON.parse(result.stdout)) {
      // Newest first; keep the first (latest) state seen per branch.
      if (!index.has(pr.headRefName)) {
        index.set(pr.headRefName, pr.state);
      }
    }
  } catch {
    /* ignore */
  }
  return index;
}

// Worktrees leak whenever a herdr workspace dies without `dev done` (closed
// in the herdr UI, session reset, reboot): the workspace list is dev's only
// record of live contexts, so the checkout stays on disk with nothing left
// pointing at it. Reconcile from git's own worktree registry instead: any
// <repo>-wt-* checkout that no live context accounts for is stale. Clean ones
// are removed (branch kept, same contract as `dev done`); dirty ones are
// only reported — never deleted.
function cmdPrune(rest) {
  requireCommand("git");
  requireCommand("herdr");

  const dryRun = rest.includes("--dry-run") || rest.includes("-n");
  const all = rest.includes("--all");
  const repos = loadRepos();
  const summary = prune(repos, { dryRun, askGitHub: all, verbose: true });
  console.log(
    `prune: ${summary.worktrees} worktree${summary.worktrees === 1 ? "" : "s"}, ` +
      `${summary.branches} branch${summary.branches === 1 ? "" : "es"}, ` +
      `${summary.workspaces} workspace${summary.workspaces === 1 ? "" : "s"} ` +
      `${dryRun ? "would be" : ""} removed; ${summary.skipped} dirty skipped`,
  );
}

// Fast reconcile used by the dashboard: no GitHub calls, never noisy.
function quietPrune(repos) {
  try {
    const summary = prune(repos, { dryRun: false, askGitHub: false, verbose: false });
    const total = summary.worktrees + summary.branches + summary.workspaces;
    if (total > 0) {
      console.log(
        `dev: pruned ${summary.worktrees} worktrees, ${summary.branches} branches, ${summary.workspaces} workspaces`,
      );
    }
  } catch {
    /* never block the dashboard */
  }
}

// Reconcile three registries that drift apart: git worktrees on disk, local
// branches, and herdr workspaces.
//  1. Stale worktrees (no live context) that are clean are removed.
//  2. dev-created branches (<alias>__* or pr-*) not checked out anywhere and
//     merged/closed are deleted.
//  3. herdr workspaces whose checkout no longer exists are closed. Workspaces
//     with no agent whose branch is merged are closed and their worktree
//     removed (only when clean).
// Dirty checkouts are reported and left alone. Workspaces with a live agent
// are never touched.
function prune(repos, { dryRun, askGitHub, verbose }) {
  const summary = { worktrees: 0, branches: 0, workspaces: 0, skipped: 0 };
  const log = (msg) => verbose && console.log(msg);
  const contexts = listContexts();
  const liveWorkspaces = new Set(listAgentWorkspaces());
  const prIndexes = new Map();
  const prIndexFor = (repo) => {
    if (!askGitHub) {
      return undefined;
    }
    if (!prIndexes.has(repo.path)) {
      prIndexes.set(repo.path, loadPrIndex(repo));
    }
    return prIndexes.get(repo.path);
  };

  // 3a. Workspaces pointing at a checkout that is gone.
  for (const ctx of contexts) {
    if (liveWorkspaces.has(ctx.workspace_id)) {
      continue;
    }
    if (!fs.existsSync(ctx.worktree.checkout_path)) {
      log(`prune: closing workspace ${ctx.label} (checkout missing)`);
      if (!dryRun) {
        runQuiet("herdr", ["workspace", "close", ctx.workspace_id]);
      }
      summary.workspaces += 1;
    }
  }

  // 3b. Idle workspaces whose branch is finished.
  for (const ctx of contexts) {
    if (liveWorkspaces.has(ctx.workspace_id) || !fs.existsSync(ctx.worktree.checkout_path)) {
      continue;
    }
    const alias = aliasForRepoRoot(ctx.worktree.repo_root, repos);
    const repo = repos[alias];
    if (!repo) {
      continue;
    }
    const checkout = ctx.worktree.checkout_path;
    const branch = currentBranchName(checkout);
    if (!branchIsMerged(repo, branch, { askGitHub, prIndex: prIndexFor(repo) })) {
      continue;
    }
    if (isDirty(checkout)) {
      log(`prune: skipping ${checkout} (merged but has uncommitted changes)`);
      summary.skipped += 1;
      continue;
    }
    log(`prune: closing workspace ${ctx.label} and removing ${checkout} (branch ${branch} merged)`);
    if (!dryRun) {
      runCapture("herdr", ["worktree", "remove", "--workspace", ctx.workspace_id], { check: false });
      if (fs.existsSync(checkout)) {
        runQuiet("git", ["-C", repo.path, "worktree", "remove", checkout]);
      }
      runQuiet("git", ["-C", repo.path, "branch", "-D", branch]);
    }
    summary.workspaces += 1;
    summary.worktrees += 1;
    summary.branches += 1;
  }

  // 1. Stale worktrees on disk.
  const stale = findStaleWorktrees(repos, listContexts());
  for (const { repo, path: wtPath, dirty } of stale) {
    if (dirty) {
      log(`prune: skipping ${wtPath} (uncommitted changes)`);
      summary.skipped += 1;
      continue;
    }
    const branch = currentBranchName(wtPath);
    log(`prune: removing ${wtPath}`);
    if (!dryRun) {
      runQuiet("git", ["-C", repo.path, "worktree", "remove", wtPath]);
    }
    summary.worktrees += 1;
    if (branch && branchIsMerged(repo, branch, { askGitHub, prIndex: prIndexFor(repo) })) {
      log(`prune: deleting merged branch ${branch}`);
      if (!dryRun) {
        runQuiet("git", ["-C", repo.path, "branch", "-D", branch]);
      }
      summary.branches += 1;
    }
  }

  // 2. Orphan dev branches (not checked out anywhere) that are finished.
  for (const [alias, repo] of Object.entries(repos)) {
    const checkedOut = new Set(
      runCapture("git", ["-C", repo.path, "worktree", "list", "--porcelain"], { check: false })
        .stdout.split("\n")
        .filter((line) => line.startsWith("branch refs/heads/"))
        .map((line) => line.slice("branch refs/heads/".length)),
    );
    const branches = runCapture(
      "git",
      ["-C", repo.path, "for-each-ref", "--format=%(refname:short)", "refs/heads/"],
      { check: false },
    ).stdout.split("\n").filter(Boolean);
    for (const branch of branches) {
      const devOwned = branch.startsWith(`${alias}${LABEL_SEP}`) || branch.startsWith("pr-");
      if (!devOwned || checkedOut.has(branch) || branch === repo.base) {
        continue;
      }
      if (!branchIsMerged(repo, branch, { askGitHub, prIndex: prIndexFor(repo) })) {
        continue;
      }
      log(`prune: deleting merged branch ${alias}:${branch}`);
      if (!dryRun) {
        runQuiet("git", ["-C", repo.path, "branch", "-D", branch]);
      }
      summary.branches += 1;
    }
  }

  return summary;
}

function listAgentWorkspaces() {
  try {
    return herdrJson(["agent", "list"]).result.agents.map((a) => a.workspace_id);
  } catch {
    return [];
  }
}

function isDirty(checkout) {
  return Boolean(
    runCapture("git", ["-C", checkout, "status", "--porcelain"], { check: false }).stdout.trim(),
  );
}

// A worktree is live if a context checks it out directly, or if it is a
// sibling checkout of a live cross context (cross siblings share the bare
// task branch but have no workspace of their own — cmdDone has the same
// special case).
function findStaleWorktrees(repos, contexts) {
  const trackedPaths = new Set(
    contexts.map((ctx) => path.resolve(ctx.worktree.checkout_path)),
  );
  const liveLabels = new Set(contexts.map((ctx) => ctx.label));

  const stale = [];
  for (const repo of Object.values(repos)) {
    runQuiet("git", ["-C", repo.path, "worktree", "prune"]);
    const listing = runCapture(
      "git",
      ["-C", repo.path, "worktree", "list", "--porcelain"],
      { check: false },
    ).stdout;
    for (const block of listing.split("\n\n")) {
      const match = block.match(/^worktree (.+)$/m);
      if (!match) {
        continue;
      }
      const wtPath = match[1];
      if (!wtPath.startsWith(`${repo.path}-wt-`)) {
        continue; // canonical checkout, or not created by dev
      }
      if (trackedPaths.has(path.resolve(wtPath))) {
        continue;
      }
      const branch = currentBranchName(wtPath);
      if (branch && !branch.includes(LABEL_SEP) && liveLabels.has(branch)) {
        continue; // sibling of a live cross context
      }
      const dirty = runCapture(
        "git",
        ["-C", wtPath, "status", "--porcelain"],
        { check: false },
      ).stdout.trim();
      stale.push({ repo, path: wtPath, dirty: Boolean(dirty) });
    }
  }
  return stale;
}

function cmdRefresh(rest) {
  const repos = loadRepos();
  const alias = rest[0] || inferCurrentRepoAlias();
  const repo = repos[alias];
  if (!repo) {
    fail(`Unknown repo '${alias}'. Add it to ${DEV_REPOS_FILE}.`);
  }

  refreshCanonicalRepo(alias, repo);
}

function cmdSync() {
  requireInsideGitRepo("dev sync");

  const repos = loadRepos();
  const alias = inferCurrentRepoAlias();
  const repo = repos[alias];
  if (!repo) {
    fail(`Unknown repo '${alias}'. Add it to ${DEV_REPOS_FILE}.`);
  }

  const repoRoot = gitTopLevel();
  assertClean(repoRoot, "Commit or stash changes before dev sync.");
  requireCommand("git");

  runInherit("git", ["-C", repoRoot, "fetch", "origin", repo.base]);

  const currentBranch = currentBranchName(repoRoot);
  if (!currentBranch) {
    fail("Detached HEAD. Checkout a branch before running dev sync.");
  }

  if (currentBranch === repo.base) {
    runInherit("git", ["-C", repoRoot, "pull", "--ff-only", "origin", repo.base]);
    return;
  }

  runInherit("git", ["-C", repoRoot, "rebase", `origin/${repo.base}`]);
}

function cmdBootstrap() {
  requireInsideGitRepo("dev bootstrap");
  bootstrapWorktree(gitTopLevel());
}

function cmdLs() {
  const repos = loadRepos();
  const contexts = listContexts();
  if (contexts.length === 0) {
    console.log("No active contexts.");
  }

  for (const ctx of contexts) {
    console.log(
      [
        contextLabel(ctx, repos).padEnd(40),
        (ctx.agent_status || "unknown").padEnd(8),
        ctx.worktree.checkout_path,
      ].join(" "),
    );
  }

  const stale = findStaleWorktrees(repos, contexts);
  if (stale.length > 0) {
    console.log(
      `\ndev: ${stale.length} stale worktree${stale.length === 1 ? "" : "s"} on disk — run 'dev prune' to clean up.`,
    );
  }
}

const LOCKFILE_COMMANDS = [
  { file: "bun.lock", cmd: ["bun", "install"] },
  { file: "bun.lockb", cmd: ["bun", "install"] },
  { file: "pnpm-lock.yaml", cmd: ["pnpm", "install", "--frozen-lockfile"] },
  { file: "yarn.lock", cmd: ["yarn", "install"] },
  { file: "package-lock.json", cmd: ["npm", "ci"] },
];

function bootstrapWorktree(worktreePath) {
  const resolved = path.resolve(worktreePath);

  if (fs.existsSync(path.join(resolved, ".par.yaml"))) {
    console.log(`bootstrap: ${resolved} has .par.yaml, skipping generic bootstrap`);
    return;
  }

  for (const { file, cmd } of LOCKFILE_COMMANDS) {
    if (fs.existsSync(path.join(resolved, file))) {
      console.log(`bootstrap: found ${file}, running ${cmd.join(" ")}`);
      const result = spawnSync(cmd[0], cmd.slice(1), {
        stdio: "inherit",
        cwd: resolved,
        env: process.env,
      });
      if (result.status !== 0) {
        console.error(`bootstrap: ${cmd.join(" ")} failed (exit ${result.status})`);
      }
      return;
    }
  }

  console.log(`bootstrap: no lockfile found in ${resolved}, nothing to do`);
}

function createOrOpenSingleRepoContext(alias, task, repo) {
  const branch = `${alias}${LABEL_SEP}${task}`;
  const worktreePath = `${repo.path}-wt-${task}`;

  const existing = listContexts().find((ctx) =>
    samePath(ctx.worktree.checkout_path, worktreePath),
  );
  if (existing) {
    focusWorkspace(existing.workspace_id);
    return;
  }

  if (fs.existsSync(worktreePath)) {
    const opened = herdrJson([
      "worktree",
      "open",
      "--cwd",
      repo.path,
      "--path",
      worktreePath,
      "--label",
      task,
      "--no-focus",
      "--json",
    ]);
    const workspaceId = opened.result.workspace.workspace_id;
    ensureTabs(workspaceId, worktreePath, [], branch);
    focusWorkspace(workspaceId);
    return;
  }

  fetchBase(alias, repo);
  const created = herdrJson([
    "worktree",
    "create",
    "--cwd",
    repo.path,
    "--branch",
    branch,
    "--base",
    baseRef(repo),
    "--path",
    worktreePath,
    "--label",
    task,
    "--no-focus",
    "--json",
  ]);
  const workspaceId = created.result.workspace.workspace_id;

  bootstrapWorktree(worktreePath);
  ensureTabs(workspaceId, worktreePath, [], branch);
  focusWorkspace(workspaceId);
}

function ensureTabs(workspaceId, defaultCwd, extraTabs = [], paneName = "") {
  const tabs = herdrJson(["tab", "list", "--workspace", workspaceId]).result.tabs;
  if (tabs.length === 0) {
    return;
  }

  const labels = new Set(tabs.map((tab) => tab.label));
  if (!labels.has("shell")) {
    runQuiet("herdr", ["tab", "rename", tabs[0].tab_id, "shell"]);
  }

  const wanted = [
    ...extraTabs,
    ...DEFAULT_TABS.filter((name) => name !== "shell").map((name) => ({
      name,
      cwd: defaultCwd,
    })),
  ];
  for (const { name, cwd } of wanted) {
    if (labels.has(name)) {
      continue;
    }
    const created = runCapture(
      "herdr",
      ["tab", "create", "--workspace", workspaceId, "--label", name, "--cwd", cwd, "--no-focus", "--json"],
      { check: false },
    );
    // Name the agent pane after the context so the agents panel reads the task.
    if (name === "agent" && paneName && created.status === 0) {
      try {
        const paneId = JSON.parse(created.stdout).result.root_pane.pane_id;
        runQuiet("herdr", ["pane", "rename", paneId, paneName]);
      } catch {
        /* cosmetic */
      }
    }
  }
}

function listContexts() {
  const workspaces = herdrJson(["workspace", "list"]).result.workspaces;
  return workspaces.filter((ws) => ws.worktree?.is_linked_worktree);
}

function contextLabel(ctx, repos) {
  const alias = aliasForRepoRoot(ctx.worktree.repo_root, repos);
  if (!alias || ctx.label.startsWith(`${alias}${LABEL_SEP}`)) {
    return ctx.label;
  }
  return `${alias}${LABEL_SEP}${ctx.label}`;
}

function aliasForRepoRoot(repoRoot, repos) {
  for (const [alias, repo] of Object.entries(repos)) {
    if (samePath(repo.path, repoRoot)) {
      return alias;
    }
  }
  return "";
}

function findContextByLabel(label, repos) {
  const contexts = listContexts();
  return (
    contexts.find((ctx) => contextLabel(ctx, repos) === label) ||
    contexts.find((ctx) => ctx.label === label)
  );
}

function focusContextByLabel(label, repos) {
  const ctx = findContextByLabel(label, repos);
  if (!ctx) {
    fail(`No context named '${label}'.`);
  }
  focusWorkspace(ctx.workspace_id);
}

function currentContext() {
  const contexts = listContexts();

  const wsId = process.env.HERDR_WORKSPACE_ID;
  if (wsId) {
    const match = contexts.find((ctx) => ctx.workspace_id === wsId);
    if (match) {
      return match;
    }
  }

  try {
    const topLevel = gitTopLevel();
    return contexts.find((ctx) => samePath(ctx.worktree.checkout_path, topLevel));
  } catch {
    return undefined;
  }
}

function focusWorkspace(workspaceId) {
  runCapture("herdr", ["workspace", "focus", workspaceId]);
}

function herdrJson(args) {
  const result = runCapture("herdr", args);
  try {
    return JSON.parse(result.stdout);
  } catch {
    fail(`Unexpected herdr output for 'herdr ${args.join(" ")}': ${result.stdout.slice(0, 200)}`);
  }
}

// Update the remote-tracking ref so new worktrees branch from a fresh
// origin/<base>. Unlike refreshCanonicalRepo this never touches the canonical
// checkout, so it works while an agent has it dirty or on another branch.
function fetchBase(alias, repo) {
  requireCommand("git");
  runInherit("git", ["-C", repo.path, "fetch", "origin", repo.base]);
}

function baseRef(repo) {
  return `origin/${repo.base}`;
}

// Full canonical refresh (clean + on base + pulled). Only `dev refresh` needs
// this; context creation branches from origin/<base> and skips it entirely.
function refreshCanonicalRepo(alias, repo) {
  requireCommand("git");

  if (isBare(repo.path)) {
    // Bare canonical: no working tree to switch; just move the base ref.
    runInherit("git", ["-C", repo.path, "fetch", "origin", `${repo.base}:${repo.base}`]);
    return;
  }

  assertClean(
    repo.path,
    `Canonical clone ${alias} is dirty. Clean it before branching from ${repo.base}.`,
  );

  runInherit("git", ["-C", repo.path, "fetch", "origin", repo.base]);

  if (!localBranchExists(repo.path, repo.base)) {
    runInherit("git", [
      "-C",
      repo.path,
      "switch",
      "--create",
      repo.base,
      "--track",
      `origin/${repo.base}`,
    ]);
  } else if (currentBranchName(repo.path) !== repo.base) {
    runInherit("git", ["-C", repo.path, "switch", repo.base]);
  }

  runInherit("git", ["-C", repo.path, "pull", "--ff-only", "origin", repo.base]);
}

function isBare(repoPath) {
  return (
    runCapture("git", ["-C", repoPath, "rev-parse", "--is-bare-repository"], { check: false })
      .stdout.trim() === "true"
  );
}

function localBranchExists(repoPath, branch) {
  const result = runCapture(
    "git",
    ["-C", repoPath, "show-ref", "--verify", "--quiet", `refs/heads/${branch}`],
    { check: false },
  );
  return result.status === 0;
}

function currentBranchName(repoPath) {
  return runCapture("git", ["-C", repoPath, "branch", "--show-current"], {
    check: false,
  }).stdout.trim();
}

function assertClean(repoPath, message) {
  const status = runCapture("git", ["-C", repoPath, "status", "--porcelain"]).stdout.trim();
  if (status) {
    fail(message);
  }
}

function inferCurrentRepoAlias() {
  const repos = loadRepos();
  const current = gitTopLevel();
  const currentBranch = currentBranchName(current);

  if (currentBranch.includes(LABEL_SEP)) {
    const [alias] = currentBranch.split(LABEL_SEP, 1);
    if (repos[alias]) {
      return alias;
    }
  }

  for (const [alias, repo] of Object.entries(repos)) {
    if (samePath(repo.path, current)) {
      return alias;
    }
  }

  const remoteName = originRepoName(current);
  if (remoteName && repos[remoteName]) {
    return remoteName;
  }

  fail(
    "Could not infer the current repo alias. Run from a configured repo or branch created by dev.",
  );
}

function originRepoName(repoPath) {
  const remote = runCapture(
    "git",
    ["-C", repoPath, "config", "--get", "remote.origin.url"],
    { check: false },
  ).stdout.trim();

  if (!remote) {
    return "";
  }

  const normalized = remote.replace(/\.git$/, "");
  const segments = normalized.split(/[/:]/);
  return segments[segments.length - 1] || "";
}

function cmdRepos(rest) {
  const repos = loadRepos();
  const entries = Object.entries(repos).sort(([a], [b]) => a.localeCompare(b));
  if (rest.includes("--json")) {
    console.log(
      JSON.stringify({
        repos: entries.map(([alias, repo]) => ({
          alias,
          path: repo.path,
          defaultBranch: repo.base,
        })),
      }),
    );
    return;
  }
  for (const [alias, repo] of entries) {
    console.log(`${alias.padEnd(40)} ${repo.base.padEnd(8)} ${repo.path}`);
  }
}

function loadRepos() {
  const repos = scanReposDir();
  const hasTsv = fs.existsSync(DEV_REPOS_FILE);
  if (!hasTsv && Object.keys(repos).length === 0) {
    fail(
      `No repos found. Set DEV_REPOS_DIR to a folder of git checkouts, or create ${DEV_REPOS_FILE} with: alias<TAB>path<TAB>default_branch`,
    );
  }
  if (!hasTsv) {
    return repos;
  }

  // repos.tsv entries override scanned repos (custom aliases, paths outside
  // the base dir, non-default base branches).
  const lines = fs.readFileSync(DEV_REPOS_FILE, "utf8").split("\n");
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) {
      continue;
    }

    const [alias, repoPath, base = "main"] = trimmed.split("\t");
    if (!alias || !repoPath) {
      fail(`Invalid repos.tsv line: ${line}`);
    }

    repos[alias] = {
      path: expandHome(repoPath),
      base,
    };
  }

  return repos;
}

/**
 * Derives the registry from a base folder: every direct child with a .git
 * DIRECTORY is a repo (alias = folder name). Linked worktrees keep .git as a
 * file, so <repo>-wt-<task> checkouts are excluded automatically.
 * Base dir: $DEV_REPOS_DIR, else the parent dir of the first repos.tsv entry.
 */
function scanReposDir() {
  const reposDir = resolveReposDir();
  const repos = {};
  if (!reposDir || !fs.existsSync(reposDir)) {
    return repos;
  }
  for (const entry of fs.readdirSync(reposDir, { withFileTypes: true })) {
    if (!entry.isDirectory() && !entry.isSymbolicLink()) {
      continue;
    }
    const repoPath = path.join(reposDir, entry.name);
    let gitStat;
    try {
      gitStat = fs.statSync(path.join(repoPath, ".git"));
    } catch {
      continue;
    }
    if (!gitStat.isDirectory()) {
      continue;
    }
    repos[entry.name] = {
      path: repoPath,
      base: detectDefaultBranch(repoPath),
    };
  }
  return repos;
}

function resolveReposDir() {
  if (process.env.DEV_REPOS_DIR) {
    return expandHome(process.env.DEV_REPOS_DIR);
  }
  if (!fs.existsSync(DEV_REPOS_FILE)) {
    return null;
  }
  for (const line of fs.readFileSync(DEV_REPOS_FILE, "utf8").split("\n")) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) {
      continue;
    }
    const repoPath = trimmed.split("\t")[1];
    if (repoPath) {
      return path.dirname(expandHome(repoPath));
    }
  }
  return null;
}

/** Reads origin's HEAD ref from disk (no git subprocess); falls back to main. */
function detectDefaultBranch(repoPath) {
  try {
    const head = fs.readFileSync(
      path.join(repoPath, ".git", "refs", "remotes", "origin", "HEAD"),
      "utf8",
    );
    const match = head.match(/refs\/remotes\/origin\/(.+)\s*$/);
    if (match) {
      return match[1].trim();
    }
  } catch {
    /* no origin HEAD recorded */
  }
  return "main";
}

function gitTopLevel() {
  const result = runCapture("git", ["rev-parse", "--show-toplevel"], { check: false });
  if (result.status !== 0) {
    fail("Not inside a git repository.");
  }
  return result.stdout.trim();
}

function requireInsideGitRepo(commandName) {
  const result = runCapture("git", ["rev-parse", "--show-toplevel"], { check: false });
  if (result.status !== 0) {
    fail(`${commandName} must run inside a git repository.`);
  }
}

function hasCommand(command) {
  const result = spawnSync("sh", ["-c", `command -v "${command}" >/dev/null 2>&1`], {
    stdio: "ignore",
  });
  return result.status === 0;
}

function requireCommand(command) {
  if (!hasCommand(command)) {
    fail(`Missing required command: ${command}`);
  }
}

function runFzf(options, prompt) {
  const result = spawnSync("fzf", ["--prompt", prompt], {
    input: options.join("\n"),
    encoding: "utf8",
    stdio: ["pipe", "pipe", "inherit"],
  });

  if (result.status !== 0) {
    return "";
  }

  return result.stdout.trim();
}

async function promptText(question) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });
  return rl.question(question).then((answer) => {
    rl.close();
    return answer.trim();
  });
}

function normalizeTask(task) {
  const normalized = task
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_-]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");

  if (!normalized) {
    fail("Task cannot be empty.");
  }

  return normalized;
}

function expandHome(value) {
  if (value.startsWith("~/")) {
    return path.join(os.homedir(), value.slice(2));
  }
  return value;
}

function samePath(left, right) {
  return path.resolve(left) === path.resolve(right);
}

function runInherit(command, args, options = {}) {
  const result = spawnSync(command, args, {
    stdio: "inherit",
    cwd: options.cwd,
    env: process.env,
  });
  if (result.status !== 0) {
    process.exit(result.status || 1);
  }
}

function runQuiet(command, args, options = {}) {
  const result = spawnSync(command, args, {
    stdio: "ignore",
    cwd: options.cwd,
    env: process.env,
  });
  return result.status === 0;
}

function runCapture(command, args, options = {}) {
  const result = spawnSync(command, args, {
    encoding: "utf8",
    cwd: options.cwd,
    env: process.env,
    stdio: ["ignore", "pipe", "pipe"],
  });

  if (options.check !== false && result.status !== 0) {
    fail((result.stderr || `Command failed: ${command} ${args.join(" ")}`).trim());
  }

  return {
    status: result.status ?? 1,
    stdout: result.stdout || "",
    stderr: result.stderr || "",
  };
}

function fail(message, code = 1) {
  console.error(`dev: ${message}`);
  process.exit(code);
}

main().catch((error) => {
  fail(error?.message || String(error));
});
